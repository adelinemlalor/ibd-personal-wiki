{
  "model": "gemma4:e2b-it-qat",
  "ollama_url": "http://127.0.0.1:11434",
  "mode": "local",
  "num_ctx": 8192,
  "temperature": 0.2,
  "chat_temperature": 0.7,

  "vault_dir": "vault",
  "raw_dir": "vault/raw",
  "wiki_dir": "vault/wiki",
  "index_file": "vault/index.md",
  "catalog_file": "vault/Source Catalog.md",
  "state_dir": ".wiki-state",
  "runs_dir": "runs",
  "prompts_dir": "prompts",

  "wiki_folders": ["Courses", "Concepts", "Projects", "Tools"],

  "chunk_chars": 900,
  "chunk_overlap": 150,
  "ingest_section_chars": 6000,
  "max_concepts_per_source": 4,

  "ask_top_k": 5,
  "ask_min_score": 2.0,
  "chat_top_k": 4,
  "search_top_k": 5,
  "chat_history_turns": 6
